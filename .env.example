# fileshare configuration (consumed by systemd EnvironmentFile)
# Generate a password hash:
#   printf '%s' 'your-password' | fileshare hash-password
FILESHARE_PASSWORD_HASH=pbkdf2-sha256:600000:REPLACE_WITH_SALT_HEX:REPLACE_WITH_HASH_HEX

# Optional separate password for WebDAV clients. Falls back to the main password.
# FILESHARE_DAV_PASSWORD_HASH=

FILESHARE_ADDR=0.0.0.0:8087
FILESHARE_DATA_DIR=/srv/fileshare-data
FILESHARE_QUOTA_BYTES=128849018880
FILESHARE_MAX_UPLOAD_BYTES=5368709120
FILESHARE_MIN_FREE_BYTES=3221225472
FILESHARE_WEBDAV=1

# Auto-cleanup: files older than this are moved to Trash (0 = disabled).
FILESHARE_RETENTION_DAYS=30
# Trash items are permanently deleted after this many days (0 = manual only).
FILESHARE_TRASH_DAYS=30
# How often the cleanup sweep runs.
FILESHARE_SWEEP_MINUTES=30

# Optional TLS (e.g. behind another reverse proxy). Leave empty for HTTP.
# FILESHARE_TLS_CERT=
# FILESHARE_TLS_KEY=
