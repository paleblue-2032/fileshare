[Unit]
Description=Personal fileshare server
Documentation=https://github.com/paleblue-2032/fileshare
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fileshare
Group=fileshare
WorkingDirectory=/srv/fileshare
EnvironmentFile=/srv/fileshare/.env
ExecStart=/srv/fileshare/result/bin/fileshare
Restart=always
RestartSec=3

# Resource limits: keep the existing services responsive.
Nice=10
CPUSchedulingPolicy=batch
CPUQuota=75%
MemoryHigh=256M
MemoryMax=384M
TasksMax=128
IOAccounting=true
IOWeight=50
OOMPolicy=stop
LimitNOFILE=65536

# Sandbox: only the data directory is writable.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/srv/fileshare-data

[Install]
WantedBy=multi-user.target
